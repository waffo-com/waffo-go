{
  "module": "rsa-signing",
  "version": "1.0.0",
  "description": "Canonical RSA signing test vectors for cross-language compatibility",
  "algorithm": {
    "name": "SHA256withRSA",
    "standardName": "RSASSA-PKCS1-v1_5",
    "keySize": 2048,
    "privateKeyFormat": "PKCS#8 DER encoded, Base64 string",
    "publicKeyFormat": "X.509 SubjectPublicKeyInfo DER encoded, Base64 string"
  },
  "testKeys": {
    "description": "2048-bit RSA key pair for testing only - DO NOT use in production",
    "privateKey": "",
    "publicKey": ""
  },
  "signingTests": [
    {
      "id": "RSA-001",
      "name": "sign_basic_json",
      "description": "Sign: sign_basic_json",
      "input": {
        "data": "{\"paymentRequestId\":\"test-123\",\"amount\":\"100.00\"}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-002",
      "name": "sign_unicode_data",
      "description": "Sign: sign_unicode_data",
      "input": {
        "data": "{\"description\":\"测试订单\",\"amount\":\"100.00\"}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-003",
      "name": "sign_empty_object",
      "description": "Sign: sign_empty_object",
      "input": {
        "data": "{}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-004",
      "name": "sign_complex_nested",
      "description": "Sign: sign_complex_nested",
      "input": {
        "data": "{\"order\":{\"id\":\"123\",\"items\":[{\"name\":\"Product\",\"qty\":1}]},\"user\":{\"email\":\"test@example.com\"}}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-005",
      "name": "sign_special_characters",
      "description": "Sign: sign_special_characters",
      "input": {
        "data": "{\"desc\":\"Test & Demo <script>alert('xss')</script>\",\"amount\":\"99.99\"}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-006",
      "name": "sign_large_payload",
      "description": "Sign: sign_large_payload",
      "input": {
        "data": "{\"items\":[{\"id\":1,\"name\":\"Product 1\",\"price\":\"10.00\"},{\"id\":2,\"name\":\"Product 2\",\"price\":\"20.00\"},{\"id\":3,\"name\":\"Product 3\",\"price\":\"30.00\"}],\"metadata\":{\"version\":\"1.0\",\"timestamp\":\"2024-01-01T00:00:00Z\"}}"
      },
      "output": {
        "signature": ""
      }
    },
    {
      "id": "RSA-007",
      "name": "sign_empty_string",
      "description": "Sign: sign_empty_string",
      "input": {
        "data": ""
      },
      "output": {
        "signature": ""
      }
    }
  ],
  "verificationTests": [
    {
      "id": "RSA-V01",
      "name": "verify_valid_signature",
      "description": "Verify a valid signature returns true",
      "input": {
        "data": "{\"test\":\"data\"}",
        "signature": ""
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "RSA-V02",
      "name": "verify_invalid_signature",
      "description": "Verify an invalid signature returns false",
      "input": {
        "data": "{\"test\":\"data\"}",
        "signature": "aW52YWxpZC1zaWduYXR1cmU="
      },
      "expected": {
        "valid": false
      }
    },
    {
      "id": "RSA-V03",
      "name": "verify_tampered_data",
      "description": "Verify signature fails if data is tampered",
      "input": {
        "originalData": "{\"test\":\"original\"}",
        "tamperedData": "{\"test\":\"tampered\"}",
        "signatureOfOriginal": ""
      },
      "expected": {
        "valid": false
      }
    }
  ],
  "crossLanguageNote": "RSASSA-PKCS1-v1_5 signatures are deterministic for the same key and UTF-8 input. Every SDK must produce these exact Base64 signatures and verify them with the provided public key."
}
